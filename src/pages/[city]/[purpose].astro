---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/sections/Hero.astro";
import Testimonies from "../../components/sections/Testimonies.astro";
import Services from "../../components/sections/Services.astro";
import CTA from "../../components/sections/CTA.astro";
import Priorities from "../../components/sections/Priorities.astro";
import Whatsapp from "../../components/shared/Whatsapp.astro";
import { cities, purposes } from "../../utils/data.ts";
import FAQ from "../../components/sections/FAQ.astro";

export async function getStaticPaths() {
  const paths: {
    params: {
      city: string;
      purpose: string;
    }
  }[] = [];

  for (const city of cities) {
    for (const purpose of purposes) {
      paths.push({
        params: {
          city: city.slug,
          purpose: purpose.slug,
        },
      });
    }
  }

  return paths;
}

const { city: citySlug, purpose: purposeSlug } = Astro.params;
const cityData = cities.find((c) => c.slug === citySlug);
const purposeData = purposes.find((p) => p.slug === purposeSlug);

const canonicalUrl = `https://jasaberkah.id/${citySlug}/${purposeSlug}`;

if (!cityData || !purposeData) {
  throw new Error(`Invalid city or purpose: ${cityData?.slug}, ${purposeData?.slug}`);
}
---

<Layout location={cityData.name} purpose={purposeData.name} canonicalUrl={canonicalUrl}>
  <main class="flex flex-col overflow-hidden">
    <Whatsapp useApi="true" mobile="6281249863105" message=`Hai Kak, Saya ingin tahu lebih lanjut mengenai jasa pengurusan ${purposeData.name} di Berkah Jasa untuk wilayah ${cityData.name}` />
    <Hero className="py-10 md:py-16" location={cityData.name} purpose={purposeData.name} />
    <Priorities className="pt-10 md:pt-16" />
    <Services className="py-10 md:py-16" />
    <Testimonies className="py-10 md:py-16" />
    <FAQ className="py-10 md:py-16" />
    <CTA className="py-10 md:py-16" location={cityData.name} purpose={purposeData.name} />
  </main>
</Layout>
