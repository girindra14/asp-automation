---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero";
import WhatWeDo from "../components/sections/WhatWeDo.jsx";
import WhyChooseUs from "../components/sections/WhyChooseUs.jsx";
import OurSolutions from "../components/sections/OurSolutions.jsx";
import CTA from "../components/sections/CTA";
import OurProducts from "../components/sections/OurProducts.jsx";
import About from "../components/sections/About";
import Contact from "../components/sections/Contact";

const canonicalUrl = import.meta.env.CANONICAL_URL || "http://localhost:4321";
---

<Layout canonicalUrl={canonicalUrl}>
    <Hero
        headline={"Empowering Industry Through Smart Automation"}
        sub_headline={"End-to-end industrial automation solutions to improve efficiency, safety, and operational reliability"}
    />
    <WhatWeDo
        client:load
        headline={"What We Do"}
        description={"We provide integrated industrial automation solutions, combining reliable products, engineering expertise, and responsive support to help industries operate smarter and more efficiently."}
        solution_headline={"Core Solutions"}
    />
    <WhyChooseUs
        headline={"Why Choose Us"}
    />
    <OurSolutions
        client:load
        headline={"Our Solutions"}
    />
    <div class="relative">
        <CTA
            feature_quote={"JMSO provides customized solutions designed to solve unique welding challenges in Australia."}
            machine_quote={""}
            case_study_quote={""}
            message={1}
        />
        <div class="bg-clip-3 bg-jmso-light-blue w-full absolute h-full -bottom-px"></div>
    </div>
    <OurProducts
        client:load
        headline={"Our Products"}
    />
    <About client:load />
    <Contact />
</Layout>