---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Testimonies from "../components/sections/Testimonies.astro";
import Services from "../components/sections/Services.astro";
import CTA from "../components/sections/CTA.astro";
import Priorities from "../components/sections/Priorities.astro";
import Whatsapp from "../components/shared/Whatsapp.astro";
import FAQ from "../components/sections/FAQ.astro";

const location = "Provinsi Jawa Timur";
const purpose = "Izin Pembuatan CV, PT, NIB";
const pathname = Astro.url.pathname;
const canonicalUrl = `https://jasaberkah.id${pathname}`;
---

<Layout location={location} purpose={purpose} canonicalUrl={canonicalUrl}>
  <main class="flex flex-col overflow-hidden">
    <Whatsapp useApi="true" mobile="6281249863105" message=`Hai Kak, Saya ingin tahu lebih lanjut mengenai jasa pengurusan ${purpose} di Berkah Jasa untuk wilayah ${location}` />
    <Hero className="py-10 md:py-16" location={location} purpose={purpose} />
    <Priorities className="pt-10 md:pt-16" />
    <Services className="py-10 md:py-16" />
    <Testimonies className="py-10 md:py-16" />
    <FAQ className="py-10 md:py-16" />
    <CTA className="py-10 md:py-16" location={location} purpose={purpose} />
  </main>
</Layout>
