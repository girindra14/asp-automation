---
import Application from "../components/sections/Application.jsx";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/ui/navbar.tsx";
import Hero from "../components/sections/Hero";
import CTA from "../components/sections/CTA";
import Problems from "../components/sections/Problems";
import Chart from "../components/sections/Chart";
import Approach from "../components/sections/Approach";
import CaseStudy from "../components/sections/CaseStudy";
import SupportSteps from "../components/sections/SupportSteps";
import FAQ from "../components/sections/FAQ";
import About from "../components/sections/About";
import Contact from "../components/sections/Contact";
import Map from "../components/sections/Map";
---

<Layout>
    <Navbar />
    <Hero
        hero_headline={"Empowering Industry Through Smart Automation"}
        hero_sub_headline={"End-to-end industrial automation solutions to improve efficiency, safety, and operational reliability"}
    />
    <Application
        client:load
        feature_headline={"What We Do"}
        feature_description={"We provide integrated industrial automation solutions, combining reliable products, engineering expertise, and responsive support to help industries operate smarter and more efficiently."}
        feature_industry_headline={"Core Solutions"}
        feature_industry_description={
        `Australia, known for its vast resources and remote regions, is heavily reliant on sectors like mining and construction. However, labor shortages and the logistical challenges of working in harsh, isolated environments have intensified the need for more efficient solutions. Rising infrastructure demands require advanced technologies to bridge the gap in manpower and ensure quality and durability across long-term projects.
         Automatic welding machines are essential in addressing these challenges, offering precision and durability that manual labor often falls short of in remote or high-stakes conditions. By automating welding processes, industries can overcome labor shortages and enhance productivity, ensuring projects remain on schedule while maintaining high standards of safety and quality.`
        }
    />
