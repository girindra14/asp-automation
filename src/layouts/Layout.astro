---
import Navbar from "../components/ui/navbar.tsx";
import customCSS from '../styles/custom.css';

export interface Props {
  canonicalUrl: string;
}

const { canonicalUrl } = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml,image/png" href="/favicon.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta content="index,follow,all" name="robots" />
    <meta
      name="title"
      content={`ASP Automation - Your Industrial Automation Partner`}
    />
    <meta
      name="description"
      content={`ASP Automation provides integrated industrial automation solutions to improve efficiency, safety, and operational reliability across various industries.`}
    />
    <link rel="canonical" href={canonicalUrl} />
    <title>ASP Automation</title>
    <link rel="dns-prefetch" href={canonicalUrl}>
    <link rel="preconnect" href={canonicalUrl} crossorigin>
    <Fragment set:html={`<style>${customCSS}</style>`} />
    <!-- GSC -->
    <!-- <meta name="google-site-verification" content="iNcx25s2rV9q_29woQd_HQwGSUN2xibBBB-Kpw52HFg" /> -->
    <!-- End GSC -->
    <!-- Data Layer for GTM (Google Tag Manager) -->
    <!-- <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
    </script> -->
    <!-- End Data Layer for GTM (Google Tag Manager) -->
